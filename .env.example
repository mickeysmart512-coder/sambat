# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="sambat-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Authentication & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Admin Configuration (comma-separated emails)
ADMIN_EMAILS="admin@sambat.com"

# Ticketing (dummy provider defaults to success; set failed or pending to test states)
DUMMY_PAYMENT_OUTCOME="success"
NOTIFY_CHANNEL="discord"
DISCORD_WEBHOOK_URL=""
# WhatsApp Cloud adapter: an approved template is still required before enabling.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
